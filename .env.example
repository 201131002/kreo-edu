# Database — gunakan Neon/Prisma Postgres di production, atau:
# docker compose up -d  →  postgresql://kreo:kreo123@localhost:5432/kreo_dev
# npx prisma dev        →  prisma+postgres://... (auto-generated)
# Lokal (tanpa SSL):
DATABASE_URL="postgresql://kreo:kreo123@localhost:5432/kreo_dev"
# Cloud (Prisma Postgres / Neon) — gunakan sslmode=verify-full:
# DATABASE_URL="postgres://user:pass@host:5432/db?sslmode=verify-full"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Vercel Blob (opsional, untuk upload materi)
BLOB_READ_WRITE_TOKEN=""