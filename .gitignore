# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov

# next.js
/.next/
/out/

# production
/build
/dist

# misc / OS
.DS_Store
Thumbs.db
*.pem
*.log
*.tmp
*.temp
.cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — secrets stay local; .env.example may be committed
.env
.env.*
!.env.example

# vercel
.vercel

# typescript / build info
*.tsbuildinfo

# Prisma generated client (regenerated by `prisma generate` / postinstall)
/src/generated/prisma

# User uploads (keep folder structure via .gitkeep)
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
/public/uploads/badges/*
!/public/uploads/badges/.gitkeep
/public/uploads/borders/*
!/public/uploads/borders/.gitkeep
/public/uploads/site/*
!/public/uploads/site/.gitkeep

# Local IDE / editor (optional)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Grok / agent local session noise (keep project skills if you commit them intentionally)
# .grok/

# data/ — large or personal reference PDFs (skripsi sumber, contoh TA orang lain)
# Hapus 2 baris di bawah jika ingin commit PDF ke remote.
/data/skripsi/referensi/*.pdf

# Cookie jars / temp files from manual black-box runs
/tmp/
cookie*.txt
*.cookie
